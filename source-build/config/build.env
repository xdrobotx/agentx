# =============================================================================
# agentx — Build Configuration
#
# This file is sourced by both Linux and Windows build scripts.
# Values can be overridden via environment variables before invoking the build.
# =============================================================================

# ---------------------------------------------------------------------------
# Build Type
# ---------------------------------------------------------------------------
# Options: Release, Debug, RelWithDebInfo, MinSizeRel
BUILD_TYPE=Release

# ---------------------------------------------------------------------------
# Keep Build Directory?
# ---------------------------------------------------------------------------
# Set to "true" to preserve llama.cpp/build/ after install (useful for
# debugging or incremental builds). Default: false (cleaned up).
KEEP_BUILD_DIR=false

# ---------------------------------------------------------------------------
# Linux / WSL2 Install Directory
# ---------------------------------------------------------------------------
# Where built binaries are installed on Linux. Use /mnt/f/... paths if you
# want binaries accessible from Windows (e.g., /mnt/f/ai/llama.cpp/bin).
INSTALL_DIR_LINUX=$HOME/DevTools/ai/llama.cpp

# ---------------------------------------------------------------------------
# Windows Install Directory
# ---------------------------------------------------------------------------
# Where built binaries are installed on Windows (native).
INSTALL_DIR_WINDOWS=E:\ai\llama.cpp

# ---------------------------------------------------------------------------
# CUDA Architectures
# ---------------------------------------------------------------------------
# Semicolon-separated list of compute capabilities.
#
# GPU                  | Compute | Notes
# ---------------------|---------|----------------------------------
# GTX 1060 6GB         | 6.1     | CUDA 12.9 container only
# RTX 3050 8GB         | 8.6     | CUDA 13.3 container only
# RTX 3060 / 3070      | 8.6     | RTX 40-series
# RTX 4060 / 4070 / 4080| 8.9    | RTX 40-series Ada
# RTX 4090             | 8.9     | RTX 40-series Ada
# H100 / A100          | 8.0     | Datacenter GPUs
#
# For multi-GPU builds, include all architectures:
#   CUDA_ARCH="61;86;89"
CUDA_ARCH="61;86"

# ---------------------------------------------------------------------------
# WSL2 GPU Passthrough
# ---------------------------------------------------------------------------
# When running inside WSL2 with NVIDIA drivers (Win 11 22H2+), the container
# can access the Windows GPU directly. Ensure:
#   1. Windows NVIDIA driver >= 550+ (for CUDA 12.x)
#   2. WSL2 updated: wsl --update
#   3. GPU accessible: nvidia-smi (in WSL2 terminal)
#
# CUDA_VISIBLE_DEVICES mapping (set in run-llama.sh):
#   CUDA_VISIBLE_DEVICES=0  → first GPU detected in WSL2
#   CUDA_VISIBLE_DEVICES=1  → second GPU, etc.
